---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CityContent from '../components/CityContent.astro';
import {brand,domain,cities} from '../data/cities';
const title='Fix and Flip Loans in Augusta Metro, GA | Augusta Metro Fix & Flip Loan';
const description='Connect with potential fix and flip loan options for Augusta area investment properties. Share your purchase and renovation plan for a project-specific review.';
const businessId=`https://${domain}/#business`;
const faq=[{q:'Are you the lender?',a:'No. We connect investors with funding sources. Our funding partner determines eligibility and terms.'},{q:'Does submitting guarantee funding?',a:'No. A submission starts a review, not an approval or commitment.'}];
const jsonld=[{'@context':'https://schema.org','@type':'WebSite',name:brand,url:`https://${domain}/`},{'@context':'https://schema.org','@type':'FinancialService','@id':businessId,name:brand,url:`https://${domain}/`,areaServed:cities.map(c=>({'@type':'City',name:c.name,containedInPlace:{'@type':'State',name:'Georgia'}})),description:'Fix and flip funding connections for real estate investors across Augusta Metro. Not a direct lender.'},{'@context':'https://schema.org','@type':'Service',serviceType:'Fix and flip loan connection service',provider:{'@id':businessId},areaServed:cities.map(c=>({'@type':'City',name:c.name,containedInPlace:{'@type':'State',name:'Georgia'}}))},{'@context':'https://schema.org','@type':'FAQPage',mainEntity:faq.map(f=>({'@type':'Question',name:f.q,acceptedAnswer:{'@type':'Answer',text:f.a}}))}];
---
<Base title={title} description={description} path="/" jsonld={jsonld}><Header/><main><CityContent cityName="Augusta Metro" location="Homepage" intro="We are connectors. An Augusta area project can mean a historic in-town house, an established Columbia County subdivision, or a smaller Burke County town. The address and scope decide which sales are useful. Share the purchase, renovation and resale plan so our funding partner can review the actual deal. Our goal is funding within 48 hours once the project is clear and the documents are in order." angle="Olde Town, Summerville and Harrisburg bring different renovation questions than the subdivisions around Evans and Grovetown. Our Georgia-only service area also includes smaller towns in Lincoln, McDuffie and Burke counties, where comparable sales and utility details may need a closer look." caution="Augusta requires permits for many residential renovations, and historic-district rules can affect some exterior changes. Verify the jurisdiction and any needed approvals for the exact property. Neither a sample program term nor a submitted form promises an approval." showCityGrid={true}/></main><Footer/></Base>
